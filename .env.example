# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sundar_service_station?retryWrites=true&w=majority&appName=Cluster0

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Places API (Optional - for Google Reviews)
GOOGLE_PLACES_API_KEY=your_google_api_key
GOOGLE_PLACE_ID=your_place_id

# Admin Authentication
ADMIN_JWT_SECRET=your_jwt_secret_key
ADMIN_DEFAULT_PASSWORD=admin123
